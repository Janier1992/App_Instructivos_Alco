# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Respaldo gratuito cuando Gemini falla o se agota la cuota.
# Regístrate gratis (sin tarjeta) en https://openrouter.ai y genera una clave en "Keys".
OPENROUTER_API_KEY=""
# Modelo gratuito a usar (opcional). Verifica modelos ":free" vigentes en
# https://openrouter.ai/models?max_price=0 si este deja de estar disponible
# (los modelos gratuitos se saturan/rotan con frecuencia).
OPENROUTER_MODEL="nvidia/nemotron-3-nano-30b-a3b:free"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Persistence Configuration (opcional: persiste los PDFs del motor RAG entre reinicios)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
