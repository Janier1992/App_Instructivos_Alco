# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Respaldo gratuito cuando Gemini falla o se agota la cuota.
# Regístrate gratis (sin tarjeta) en https://openrouter.ai y genera una clave en "Keys".
OPENROUTER_API_KEY=""
# Modelos gratuitos separados por comas (opcional); se prueban en orden. Verifica modelos ":free" vigentes en
# https://openrouter.ai/models?max_price=0 si este deja de estar disponible
# (los modelos gratuitos se saturan/rotan con frecuencia).
# OJO: los ":free" rotan: nemotron-3-nano/super ":free" ya fueron retirados (404).
# Lista vigente: curl https://openrouter.ai/api/v1/models (pricing 0) o la URL de arriba.
OPENROUTER_MODEL="google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free"

# Modelos de Gemini (opcional). Si el principal esta saturado (503) o tarda de
# mas, se prueban los de respaldo en orden antes de caer a OpenRouter.
# GEMINI_MODEL="gemini-3.6-flash"
# GEMINI_FALLBACK_MODELS="gemini-3.5-flash,gemini-3.1-flash-lite"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Persistence Configuration (opcional: persiste los PDFs del motor RAG entre reinicios)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Mismos valores que SUPABASE_URL/SUPABASE_ANON_KEY, pero con el prefijo
# NEXT_PUBLIC_ para que Next.js los incluya en el bundle del navegador — la
# clave "anon" está diseñada para ser pública. Se usan para subir PDFs
# grandes directo a Supabase Storage desde el navegador (evita el límite de
# 4.5 MB por request de las funciones serverless de Vercel).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ADMIN_JWT_SECRET: firma las sesiones del Portal de Administración (/crm).
# Genera un valor aleatorio largo, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# No lo compartas ni lo subas al repositorio.
ADMIN_JWT_SECRET=""

# Correo para "¿Olvidaste tu contraseña?" del CRM (Resend, https://resend.com).
# RESEND_FROM_EMAIL debe ser de un dominio verificado en Resend, por ejemplo
# "Portal Alco <no-responder@tudominio.com>". APP_URL se usa para armar el enlace.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Notificaciones push (Web Push). Genera el par de llaves una sola vez con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_SUBJECT debe ser un mailto: o una URL de contacto. No las compartas.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@alco.com.co"
